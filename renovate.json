{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nix", "github-actions", "custom.regex"],
  "nix": { "enabled": true },
  "timezone": "America/New_York",
  "schedule": ["* 0-5 * * *"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * *"]
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^modules/server/containers/.*\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[a-zA-Z0-9][a-zA-Z0-9./_-]*):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "groupName": "container images"
    }
  ]
}
