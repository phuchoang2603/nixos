{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "nix",
    "custom.regex"
  ],
  "nix": {
    "enabled": true
  },
  "timezone": "America/New_York",
  "schedule": [
    "* 0-5 * * *"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 * * *"
    ]
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/base/cli/agents/t3-cli\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\s+version = \"(?<currentValue>[^\"]+)\";\\s+hash = \"(?<currentDigest>[^\"]+)\";"
      ],
      "datasourceTemplate": "custom.t3code",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "custom.t3code"
      ],
      "groupName": "T3 Code",
      "followTag": "latest"
    }
  ],
  "customDatasources": {
    "t3code": {
      "defaultRegistryUrlTemplate": "https://registry.npmjs.org/{{{packageName}}}",
      "transformTemplates": [
        "{\"releases\": $each(versions, function($v) { {\"version\": $v.version, \"digest\": $v.dist.integrity} }), \"tags\": $.\"dist-tags\"}"
      ]
    }
  }
}
