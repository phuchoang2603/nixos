{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "nix",
    "custom.regex"
  ],
  "nix": {
    "enabled": true
  },
  "timezone": "America/New_York",
  "schedule": [
    "* 0-5 * * *"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 * * 1"
    ]
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/base/cli/agents/t3-cli\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: depName=pingdotgg/t3code-(?<assetPlatform>\\S+)\\s+version = \"(?<currentValue>[^\"]+)\";\\s+hash = \"(?<currentDigest>[^\"]+)\";"
      ],
      "depNameTemplate": "pingdotgg/t3code-{{{assetPlatform}}}",
      "datasourceTemplate": "custom.t3code-{{{assetPlatform}}}",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "custom.t3code-linux-x64",
        "custom.t3code-darwin-arm64"
      ],
      "groupName": "T3 Code",
      "ignoreUnstable": true
    }
  ],
  "customDatasources": {
    "t3code-linux-x64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/pingdotgg/t3code/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": [$[draft = false and prerelease = false].($version := $substringAfter(tag_name, 'v'); $asset := assets[name = 't3-' & $version & '-linux-x64.tar.gz'][0]; $exists($asset.digest) ? {\"version\": $version, \"digest\": $substringAfter($asset.digest, 'sha256:')})]}"
      ]
    },
    "t3code-darwin-arm64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/pingdotgg/t3code/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": [$[draft = false and prerelease = false].($version := $substringAfter(tag_name, 'v'); $asset := assets[name = 't3-' & $version & '-darwin-arm64.tar.gz'][0]; $exists($asset.digest) ? {\"version\": $version, \"digest\": $substringAfter($asset.digest, 'sha256:')})]}"
      ]
    }
  }
}
